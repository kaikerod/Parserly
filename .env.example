POSTGRES_DB=parserly
POSTGRES_USER=parserly
POSTGRES_PASSWORD=parserly
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://parserly:parserly@localhost:5432/parserly
REDIS_URL=redis://localhost:6379/0

APP_URL=http://localhost:3000
# Production fallback: https://parserly-api.vercel.app
API_PUBLIC_URL=http://localhost:8000
SECRET_KEY=change-me-only-for-local-development
ENVIRONMENT=development
LOG_LEVEL=INFO

# Production fallback: https://parserly-api.vercel.app
API_BASE_URL=http://api:8000
WEB_PORT=3000
NEXT_TELEMETRY_DISABLED=1
WATCHPACK_POLLING=true

RESEND_API_KEY=
EMAIL_FROM="Parserly <onboarding@resend.dev>"

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-26b-a4b-it

# PIX via /v1/payments does not work with TEST-* tokens.
# For sandbox, use production credentials from a Mercado Pago test seller account.
# For local UI-only tests, set MERCADOPAGO_MOCK_PAYMENTS=true.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_API_URL=https://api.mercadopago.com
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MOCK_PAYMENTS=false
ANALYSIS_PRICE_CENTS=1990

AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=strict
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_OAUTH_STATE_COOKIE_NAME=google_oauth_state
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
UPLOAD_TMP_DIR=/tmp/parserly_uploads
